# eRISCV-M2 default config (Kconfig fragment)
# Minimal configuration for eRISCV-M2 Zephyr build

CONFIG_SOC_ERISCV_MCU=y
CONFIG_BOARD_ERISCV_MCU=y

CONFIG_SYS_CLOCK_TICKS_PER_SEC=1000
CONFIG_RISCV_MACHINE_TIMER=y

# Memory
CONFIG_SRAM_BASE_ADDRESS=0x11000000
CONFIG_SRAM_SIZE=128
CONFIG_FLASH_BASE_ADDRESS=0x10000000
CONFIG_FLASH_SIZE=128

# Console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_NS16550=n

# Kernel
CONFIG_MULTITHREADING=y
CONFIG_NUM_COOP_PRIORITIES=4
CONFIG_NUM_PREEMPT_PRIORITIES=4
CONFIG_MAIN_THREAD_PRIORITY=0
CONFIG_MAIN_STACK_SIZE=4096
CONFIG_IDLE_STACK_SIZE=1024
CONFIG_ISR_STACK_SIZE=4096

# Synchronization
CONFIG_POLL=y

# Disable unused
CONFIG_LOG=n
CONFIG_PRINTK=y
