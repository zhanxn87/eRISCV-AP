config SOC_SERIES_ERISCV_MCU
	bool "eRISCV-MCU Series"
	select RISCV
	select RISCV_PRIVILEGED
	select 32BIT
	select SOC_FAMILY_RISCV_PRIVILEGE
	help
	  eRISCV-MCU is an educational RISC-V MCU-class SoC series.

rsource "../eriscv_mcu/Kconfig.soc"
rsource "../eriscv_mcu/Kconfig.defconfig"
